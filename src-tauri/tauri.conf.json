{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiftForge",
  "version": "0.1.0",
  "identifier": "com.riftforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RiftForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/jre/": "jre/",
      "binaries/riftforge-server.jar": "riftforge-server.jar"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/preinstall.nsh"
      }
    }
  }
}
